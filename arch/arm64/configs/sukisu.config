## KernelSU support config fragment

CONFIG_SUKISU_ULTRA=y

#
# KernelSU
#
CONFIG_KSU=y
# CONFIG_KSU_DEBUG is not set
# CONFIG_KSU_ALLOWLIST_WORKAROUND is not set
# CONFIG_KSU_HOOK is not set
# CONFIG_KSU_MANUAL_HOOK is not set
CONFIG_KSU_GKI_KERNEL=y
CONFIG_KSU_HOOK_KPROBES=y
# CONFIG_KSU_CMDLINE is not set
CONFIG_KPM=y

# CONFIG_KSU_SUSFS is not set
# CONFIG_KSU_SUSFS_HAS_MAGIC_MOUNT is not set

# end of KernelSU
# end of Device Drivers