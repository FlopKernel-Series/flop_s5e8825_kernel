choice
	prompt "Select SU variant"
	optional
	help
	  Select which Kernel SU variant to build.

config KSU_NEXT
	bool "KernelSU Next"
	select OVERLAY_FS
	select KPROBES
	select EXT4_FS
	help
	  Enable KernelSU Next.
	  This is the standard KernelSU Next variant.

config KSU_SUKI
	bool "SukiSU Ultra"
	select OVERLAY_FS
	help
	  Enable SukiSU Ultra with SUSFS support.
	  This is a KernelSU fork with additional features.

config KSU_XXKSU
	bool "XXKSU"
	select OVERLAY_FS
	help
	  Enable XXKSU.
	  Backslashxx's KernelSU fork with additional features.

endchoice

choice
	prompt "Hook method"
	optional
	depends on KSU_NEXT || KSU_SUKI || KSU_XXKSU
	help
	  Select which hook method to use.

config KSU_KPROBES_HOOK
	bool "Use kprobes"
	depends on KPROBES
	help
	  Use kprobes for function hooking.

config KSU_TRACEPOINT_HOOK
	bool "Use tracepoints"
	depends on TRACEPOINTS
	help
	  Use tracepoints for function hooking.
	  Only supported by SukiSU.

config KSU_MANUAL_HOOK
	bool "Use manual hooks"
	help
	  Use manual hooks instead of kprobes/tracepoints.

config KSU_SYSCALL_HOOK
	bool "KernelSU syscall hook mode."
	depends on KPROBES && KRETPROBES && HAVE_SYSCALL_TRACEPOINTS
	help
	  Enable KPROBES, KRETPROBES and TRACEPOINT hook for KernelSU core.
	  This should not be used on kernel below 5.10.

endchoice

# Common options
config KSU_DEBUG
	bool "KernelSU debug mode"
	depends on KSU
	default n
	help
	  Enable KernelSU debug mode.

config KSU_ALLOWLIST_WORKAROUND
	bool "Session Keyring Init workaround"
	depends on KSU
	default n
	help
	  Enable session keyring init workaround for problematic devices.
	  Useful for situations where the SU allowlist is not kept after a reboot.

# Load variant-specific configs
if KSU_NEXT
source "drivers/kernelsu/kernel/Kconfig"
endif

if KSU_SUKI
source "drivers/sukisu/kernel/Kconfig"
endif

if KSU_XXKSU
source "drivers/xxksu/kernel/Kconfig"
endif
